<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivTransIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/icon_bg"
        android:padding="8dp"
        android:src="@android:drawable/stat_sys_download"
        app:tint="@color/green_credit" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/ivTransIcon"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTransTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salary Credit"
            android:textColor="@color/text_black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTransDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today, 09:28 AM"
            android:textColor="@color/text_grey"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTransAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="+ ₹45,000"
        android:textColor="@color/green_credit"
        android:textStyle="bold" />
</RelativeLayout>
