<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:name=".SafeBankApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeBank">
        
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Home"
            android:exported="false" />

        <activity
            android:name=".LoansActivity"
            android:exported="false" />

        <activity
            android:name=".LoanCalculatorActivity"
            android:exported="false" />

        <activity
            android:name=".ApplyHomeLoanActivity"
            android:exported="false" />

        <activity
            android:name=".CardsActivity"
            android:exported="false" />

        <activity
            android:name=".TransactionHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".AccountActivity"
            android:exported="false" />

        <activity
            android:name=".FixedDepositActivity"
            android:exported="false" />

        <activity
            android:name=".BillsActivity"
            android:exported="false" />

    </application>

</manifest>